# Copy this file to .env for Docker Compose.
APP_PORT=8080
NGINX_PORT=80

# Replace this with a long random value in production.
SECRET_KEY=dev-insecure-change-me
# Set true when the application is served over HTTPS.
COOKIE_SECURE=false

# ---------------------------------------------------------------- database
# Docker Compose starts PostgreSQL and builds DATABASE_URL from these values.
# Replace the password before public use. Avoid '@', ':', and '/' unless the
# password is URL-encoded in the connection string.
POSTGRES_DB=k8slab
POSTGRES_USER=k8slab
POSTGRES_PASSWORD=change-me-in-production

# Set DATABASE_URL when running the platform without Docker Compose.
# DATABASE_URL=postgresql://k8slab:change-me-in-production@localhost:5432/k8slab

# fake = simulator without a cluster | kubernetes = use real kubectl
LAB_MODE=fake

# The leaderboard covers the last N days.
LEADERBOARD_DAYS=7

# `python -m app.cleanup` removes sandboxes of users inactive for N days.
# Each user/challenge pair has its own namespace, so periodic cleanup keeps
# abandoned workloads from accumulating.
LAB_SANDBOX_IDLE_DAYS=30
LAB_SANDBOX_GRACE_MINUTES=60
# Outside Kubernetes, cluster mode runs cleanup every 15 minutes.
# Set false when a cleanup CronJob is active.
LAB_AUTO_CLEANUP=true

# ---------------------------------------------------------------- real mode
# Kubeconfig path for kubectl. A Pod using impersonation needs an explicit
# kubeconfig, such as the one mounted by the Helm chart. Leave empty only when
# relying on the default ~/.kube/config outside the cluster.
LAB_KUBECONFIG=

# Required in Kubernetes mode: each learner uses a namespace ServiceAccount.
LAB_IMPERSONATE=true
LAB_RUNNER_SA=lab-runner
LAB_RUNNER_CLUSTERROLE=lab-user

# ---------------------------------------------------------------- image challenge
# Configure the challenge image here for local Compose and uvicorn runs.
#
# This public image listens on :8080 and answers /healthz, but it does not
# reproduce every challenge symptom.
LAB_APP_IMAGE=registry.k8s.io/echoserver:1.10
LAB_APP_GOOD_TAGS=1.10,latest
#
# Replace it with your own challenge image when available:
# LAB_APP_IMAGE=ghcr.io/<owner>/k8s-lab-app:0.1.0
# LAB_APP_GOOD_TAGS=0.1.0,v0.1.0,latest
