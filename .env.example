# Salin menjadi .env untuk Docker Compose.
APP_PORT=8080

# WAJIB diganti di produksi: string acak panjang.
SECRET_KEY=dev-insecure-change-me

# fake = simulator (tanpa cluster) | kubernetes = pakai kubectl
LAB_MODE=fake

# Leaderboard dihitung dari N hari terakhir.
LEADERBOARD_DAYS=7

# ---------------------------------------------------------------- real mode
# Path kubeconfig. Kosongkan bila platform berjalan sebagai Pod (in-cluster SA)
# atau bila memakai ~/.kube/config.
LAB_KUBECONFIG=

# true  = tiap user dijalankan sebagai ServiceAccount lab-runner di namespace-nya
# false = pakai identitas kubeconfig (hanya untuk dev; terlalu kuat untuk produksi)
LAB_IMPERSONATE=true
LAB_RUNNER_SA=lab-runner
LAB_RUNNER_CLUSTERROLE=lab-user

# Image aplikasi demo. WAJIB diganti ke image yang benar-benar bisa di-pull
# oleh node cluster Anda.
LAB_APP_IMAGE=ghcr.io/change-me-owner/k8s-lab-app:0.1.0
# Tag yang dianggap valid pada challenge ImagePullBackOff.
LAB_APP_GOOD_TAGS=0.1.0,v0.1.0,latest
