# Salin menjadi .env untuk Docker Compose.
APP_PORT=8080

# WAJIB diganti di produksi: string acak panjang.
SECRET_KEY=dev-insecure-change-me

# ---------------------------------------------------------------- database
# Docker Compose menjalankan PostgreSQL dan menyusun DATABASE_URL otomatis
# dari tiga nilai di bawah. Ganti password sebelum dipakai publik, dan hindari
# karakter '@', ':', '/' di password karena ikut masuk ke URL koneksi.
POSTGRES_DB=k8slab
POSTGRES_USER=k8slab
POSTGRES_PASSWORD=change-me-in-production

# Untuk menjalankan platform tanpa Docker Compose, isi URL ini secara manual.
# Kosongkan untuk memakai SQLite lokal (data/lab.db).
# DATABASE_URL=postgresql://k8slab:change-me-in-production@localhost:5432/k8slab

# fake = simulator (tanpa cluster) | kubernetes = pakai kubectl
LAB_MODE=fake

# Leaderboard dihitung dari N hari terakhir.
LEADERBOARD_DAYS=7

# ---------------------------------------------------------------- real mode
# Path kubeconfig. Kosongkan bila platform berjalan sebagai Pod (in-cluster SA)
# atau bila memakai ~/.kube/config.
LAB_KUBECONFIG=

# true  = tiap user dijalankan sebagai ServiceAccount lab-runner di namespace-nya
# false = pakai identitas kubeconfig (hanya untuk dev; terlalu kuat untuk produksi)
LAB_IMPERSONATE=true
LAB_RUNNER_SA=lab-runner
LAB_RUNNER_CLUSTERROLE=lab-user

# ---------------------------------------------------------------- image challenge
# SATU-SATUNYA tempat mengatur image challenge. File ini dibaca oleh Docker
# Compose dan juga oleh uvicorn lokal (lewat python-dotenv).
#
# Sementara, sebelum image k8s-lab-app di-push, pakai image publik yang listen
# di :8080 dan membalas 200 di /healthz:
LAB_APP_IMAGE=registry.k8s.io/echoserver:1.10
LAB_APP_GOOD_TAGS=1.10,latest
#
# Setelah image sendiri tersedia, ganti dengan:
# LAB_APP_IMAGE=ghcr.io/<owner>/k8s-lab-app:0.1.0
# LAB_APP_GOOD_TAGS=0.1.0,v0.1.0,latest
